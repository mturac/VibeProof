{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mturac/VibeProof/main/schema/vibeproof-config.schema.json",
  "title": "VibeProof configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "commands", "browser"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "project": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string", "minLength": 1 }, "root": { "$ref": "#/$defs/repositoryPath", "default": "." }, "ref": { "type": "string", "minLength": 1 } } },
    "commands": { "type": "object", "additionalProperties": false, "required": ["start"], "properties": { "install": { "$ref": "#/$defs/command" }, "build": { "$ref": "#/$defs/command" }, "start": { "$ref": "#/$defs/startCommand" } } },
    "browser": { "type": "object", "additionalProperties": false, "required": ["baseUrl", "journey"], "properties": { "executable": { "type": "string", "minLength": 1 }, "baseUrl": { "type": "string", "minLength": 1 }, "journey": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }, "afterRestart": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }, "defaultTimeoutMs": { "type": "integer", "minimum": 1, "default": 15000 } } },
    "proof": { "type": "object", "additionalProperties": false, "properties": { "requireCleanClone": { "type": "boolean", "default": true }, "requireBuild": { "type": "boolean" }, "requireBrowser": { "type": "boolean", "default": true }, "requireRestart": { "type": "boolean", "default": false } } },
    "security": { "type": "object", "additionalProperties": false, "properties": { "allowRemoteUrls": { "type": "boolean", "default": false }, "inheritEnv": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" } }, "redactPatterns": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "maxLogBytes": { "type": "integer", "minimum": 1, "default": 2000000 } } },
    "output": { "type": "object", "additionalProperties": false, "properties": { "keepWorkspaceOnFailure": { "type": "boolean", "default": true }, "keepWorkspaceOnSuccess": { "type": "boolean", "default": false } } }
  },
  "allOf": [{ "if": { "properties": { "proof": { "type": "object", "properties": { "requireRestart": { "const": true } }, "required": ["requireRestart"] } }, "required": ["proof"] }, "then": { "properties": { "browser": { "required": ["afterRestart"] } } } }],
  "$defs": {
    "repositoryPath": { "type": "string", "minLength": 1, "not": { "anyOf": [{ "pattern": "^/" }, { "pattern": "^[A-Za-z]:[\\\\/]" }, { "pattern": "(^|[\\\\/])\\.\\.([\\\\/]|$)" }] } },
    "command": { "type": "object", "additionalProperties": false, "required": ["argv"], "properties": { "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }, "cwd": { "$ref": "#/$defs/repositoryPath" }, "timeoutMs": { "type": "integer", "minimum": 1 }, "env": { "type": "object", "propertyNames": { "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }, "additionalProperties": { "type": "string" } }, "readyUrl": { "type": "string", "minLength": 1 }, "readyTimeoutMs": { "type": "integer", "minimum": 1 } } },
    "startCommand": { "allOf": [{ "$ref": "#/$defs/command" }, { "required": ["readyUrl"] }] },
    "step": { "oneOf": [{ "$ref": "#/$defs/gotoStep" }, { "$ref": "#/$defs/waitForSelectorStep" }, { "$ref": "#/$defs/waitForTextStep" }, { "$ref": "#/$defs/assertTextStep" }, { "$ref": "#/$defs/assertSelectorStep" }, { "$ref": "#/$defs/fillStep" }, { "$ref": "#/$defs/clickStep" }, { "$ref": "#/$defs/assertUrlStep" }, { "$ref": "#/$defs/screenshotStep" }] },
    "gotoStep": { "type": "object", "additionalProperties": false, "required": ["op", "path"], "properties": { "op": { "const": "goto" }, "path": { "type": "string", "minLength": 1 }, "timeoutMs": { "type": "integer", "minimum": 1 } } },
    "waitForSelectorStep": { "type": "object", "additionalProperties": false, "required": ["op", "selector"], "properties": { "op": { "const": "waitForSelector" }, "selector": { "type": "string", "minLength": 1 }, "timeoutMs": { "type": "integer", "minimum": 1 } } },
    "waitForTextStep": { "type": "object", "additionalProperties": false, "required": ["op", "text"], "properties": { "op": { "const": "waitForText" }, "text": { "type": "string", "minLength": 1 }, "timeoutMs": { "type": "integer", "minimum": 1 } } },
    "assertTextStep": { "type": "object", "additionalProperties": false, "required": ["op", "text"], "properties": { "op": { "const": "assertText" }, "text": { "type": "string", "minLength": 1 } } },
    "assertSelectorStep": { "type": "object", "additionalProperties": false, "required": ["op", "selector"], "properties": { "op": { "const": "assertSelector" }, "selector": { "type": "string", "minLength": 1 } } },
    "fillStep": { "type": "object", "additionalProperties": false, "required": ["op", "selector", "value"], "properties": { "op": { "const": "fill" }, "selector": { "type": "string", "minLength": 1 }, "value": { "type": "string" } } },
    "clickStep": { "type": "object", "additionalProperties": false, "required": ["op", "selector"], "properties": { "op": { "const": "click" }, "selector": { "type": "string", "minLength": 1 }, "timeoutMs": { "type": "integer", "minimum": 1 } } },
    "assertUrlStep": { "type": "object", "additionalProperties": false, "required": ["op", "value"], "properties": { "op": { "const": "assertUrl" }, "value": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "object", "additionalProperties": false, "required": ["pattern"], "properties": { "pattern": { "type": "string", "minLength": 1 } } }] } } },
    "screenshotStep": { "type": "object", "additionalProperties": false, "required": ["op", "name"], "properties": { "op": { "const": "screenshot" }, "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$" }, "fullPage": { "type": "boolean" } } }
  }
}
